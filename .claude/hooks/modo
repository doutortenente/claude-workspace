#!/usr/bin/env bash
# modo — troca o grupo de skills ativo. Vale na próxima sessão do Claude Code.
#
#   modo              mostra o modo atual e o que cada um liga
#   modo plantao      só as 7 skills médicas
#   modo sasi         médicas + supabase/vercel
#   modo codigo       IDE + skills nativas do Claude
#   modo escritorio   docx, pdf, xlsx, pptx, organizar arquivo
#   modo tudo         as 41 (caro: ~4.659 tokens por mensagem)
#   modo nada         nenhuma (padrão, mais barato)
set -euo pipefail
MODO_FILE="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/modo"

if [ $# -eq 0 ]; then
  atual="nada"; [ -r "$MODO_FILE" ] && atual="$(tr -d '[:space:]' < "$MODO_FILE")"
  echo "modo atual: ${atual:-nada}"
  echo
  printf '  %-12s %s\n' \
    plantao    "7 medicas (admissao-uti, plantao, hemodinamica...)" \
    sasi       "medicas + supabase/vercel" \
    codigo     "IDE + nativas do Claude" \
    escritorio "docx, pdf, xlsx, pptx, organizar arquivo" \
    estudo     "aula-turbo, book-to-skill, find-docs" \
    tudo       "as 41 — caro" \
    nada       "nenhuma — padrao"
  echo
  echo "uso: modo <nome>"
  exit 0
fi

novo="$(echo "$1" | tr '[:upper:]' '[:lower:]')"
case "$novo" in
  plantao|sasi|codigo|escritorio|estudo|tudo|nada) ;;
  *) echo "modo desconhecido: $novo"; echo "validos: plantao sasi codigo escritorio tudo nada"; exit 1 ;;
esac

printf '%s\n' "$novo" > "$MODO_FILE"
echo "modo: $novo"
echo "vale na proxima sessao do Claude Code (ou rode /hooks para reaplicar agora)"
