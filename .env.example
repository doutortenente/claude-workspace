# ============================================================================
# Repo `claude` — modelo de variáveis de ambiente
#
# Este repo NÃO é um aplicativo: não tem build nem runtime próprio. Ele guarda
# skills, subagentes e configuração. Então aqui não existe `.env` de execução.
#
# O arquivo REAL com os segredos é ~/projetos/.env (permissão 600, fora do git).
# `sasi/.env` é um atalho (symlink) para ele. Este `.env.example` serve só para
# documentar o que a frota e as skills esperam encontrar no ambiente.
#
# REGRA: nunca commitar valor real. O .gitignore bloqueia `.env*`.
# ============================================================================

# ---- Máquina (Tijolão) ----
# Senha de administrador, usada por script que precisa de `sudo`.
# Mora em ~/projetos/.env §12. Nunca ecoar em log.
SUDO_PASSWORD=

# ---- Skill `brainstorming` (servidor local temporário) ----
# Preenchidas pela própria skill em tempo de execução; não precisam estar no cofre.
BRAINSTORM_DIR=
BRAINSTORM_HOST=127.0.0.1
BRAINSTORM_PORT=
BRAINSTORM_URL_HOST=
BRAINSTORM_OWNER_PID=

# ---- Servidor MCP genérico ----
TRANSPORT=stdio
PORT=

# ---- Roteamento de modelo dos subagentes ----
# Sobrepõe o campo `model` do frontmatter de TODOS os subagentes. Use só para
# teste — deixar isso setado faz a frota inteira rodar no mesmo modelo.
CLAUDE_CODE_SUBAGENT_MODEL=

# Profundidade máxima de aninhamento de subagente. Padrão da plataforma: 3.
# Colocar 1 desliga aninhamento globalmente. Nesta frota a trava equivalente é
# feita por agente, com `disallowedTools: Agent` no frontmatter.
CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH=

# ---- Não colocar aqui ----
# Chave de Supabase, token de GitHub e credencial clínica moram em ~/projetos/.env.
# Credencial do Google Apps Script está QUEIMADA por ordem do operador (29-jul-2026):
# não recolocar em arquivo nenhum.
