{
  "env": {
    "ULTRACOST_GATE": "off",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "cc/claude-fable-5",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:20128/v1",
    "ANTHROPIC_AUTH_TOKEN": "${ANTHROPIC_AUTH_TOKEN}",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "cc/claude-opus-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "cc/claude-sonnet-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "cc/claude-haiku-4-5-20251001"
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(bun *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(unzip *)",
      "Bash(jq *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(realpath *)",
      "Bash(readlink *)",
      "Bash(which *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(free *)",
      "Bash(ps *)",
      "Bash(date *)",
      "Read",
      "Grep",
      "Glob"
    ],
    "deny": [],
    "defaultMode": "default"
  },
  "model": "opus[1m]",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "admissao-uti": "off",
    "analise-ecott": "off",
    "aula-turbo-V2": "off",
    "book-to-skill": "off",
    "canvas-design": "off",
    "controles-vitais-janela": "off",
    "docs-update": "off",
    "docx": "off",
    "file-organizer": "off",
    "find-docs": "off",
    "hemodinamica-calculada": "off",
    "pdf": "off",
    "plantao": "off",
    "pptx": "off",
    "sasi-ingest-export": "off",
    "supabase": "off",
    "supabase-automation": "off",
    "supabase-postgres-best-practices": "off",
    "vercel-cli": "off",
    "vercel-react-best-practices": "off",
    "xlsx": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/dr/src/Claude-workspace/.claude/hooks/modo-de-skills.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/dr/src/Claude-workspace/.claude/hooks/prefer-ide-tools.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env node /home/dr/.tokentracker/bin/notify.cjs --source=claude"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env node /home/dr/.tokentracker/bin/notify.cjs --source=claude"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/dr/src/Claude-workspace/.claude/hooks/prefer-ide-tools.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "enabledPlugins": {
    "humanizer@skills-dir": false,
    "hooks-development@buildwithclaude": false,
    "nextjs-expert@buildwithclaude": false,
    "cloudflare@claude-plugins-official": false,
    "desktop-commander@claude-plugins-official": false,
    "supabase@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "airtable@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "buildwithclaude": {
      "source": {
        "source": "github",
        "repo": "davepoon/buildwithclaude"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    }
  },
  "language": "portuguese",
  "effortLevel": "high",
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "editorMode": "normal",
  "verbose": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "_comment_ultracode": "ultracode REMOVIDO 22-ago: forcava workflow multi-agente em toda tarefa, principal fonte de queima de token. Religar so sob demanda escrevendo 'ultracode' no prompt.",
  "fastMode": true,
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "agentbridge": {
      "type": "http",
      "url": "http://127.0.0.1:8642/mcp"
    },
    "jetbrains-index": {
      "type": "http",
      "url": "http://127.0.0.1:29172/index-mcp/streamable-http"
    },
    "jetbrains-steroid": {
      "type": "http",
      "url": "http://127.0.0.1:6315/mcp"
    },
    "webstorm": {
      "type": "http",
      "url": "http://127.0.0.1:64542/stream"
    }
  },
  "disabledMcpServers": [
    "agentbridge",
    "context7",
    "firecrawl",
    "jetbrains-index",
    "jetbrains-steroid",
    "playwright",
    "webstorm"
  ],
  "hasCompletedOnboarding": true,
  "_comment": "Template versionado de ~/.claude/settings.json. Secrets (ANTHROPIC_AUTH_TOKEN) são carregados do ambiente ou de ~/.local/secrets/.env. Sincronizar via: python3 ~/src/Claude-workspace/scripts/sync-claude-config.py --apply"
}
